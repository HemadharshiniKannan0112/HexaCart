{
  "info": {
    "_postman_id": "hexacart-firebase-api-2026",
    "name": "HexaCart - Firebase Auth + Firestore",
    "description": "Import with the HexaCart Firebase environment. Enter passwords locally in environment values. Firebase Auth and Firestore REST API tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseAuth",
      "value": "https://identitytoolkit.googleapis.com/v1"
    },
    {
      "key": "baseFirestore",
      "value": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Admin sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseAuth}}/accounts:signInWithPassword?key={{apiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"returnSecureToken\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const r = pm.response.json(); pm.environment.set('idToken', r.idToken); pm.environment.set('customerUid', r.localId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseAuth}}/accounts:signInWithPassword?key={{apiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"returnSecureToken\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const r = pm.response.json(); pm.environment.set('idToken', r.idToken); pm.environment.set('customerUid', r.localId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Send password reset email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseAuth}}/accounts:sendOobCode?key={{apiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestType\": \"PASSWORD_RESET\",\n  \"email\": \"{{customerEmail}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "02 - Firestore Categories & Products",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseFirestore}}/categories?key={{apiKey}}"
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseFirestore}}/products?pageSize=50&key={{apiKey}}"
          }
        },
        {
          "name": "Create product (admin only, sample id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseFirestore}}/products?documentId={{productId}}&key={{apiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"title\": {\n      \"stringValue\": \"Postman Sample Product\"\n    },\n    \"cat_id\": {\n      \"stringValue\": \"c1\"\n    },\n    \"des\": {\n      \"stringValue\": \"Created from Postman\"\n    },\n    \"qty\": {\n      \"integerValue\": \"10\"\n    },\n    \"price\": {\n      \"doubleValue\": 499.0\n    },\n    \"active\": {\n      \"booleanValue\": true\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Get product by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseFirestore}}/products/{{productId}}?key={{apiKey}}"
          }
        },
        {
          "name": "Update product (admin only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseFirestore}}/products/{{productId}}?updateMask.fieldPaths=qty&key={{apiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"qty\": {\n      \"integerValue\": \"25\"\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "Delete product (admin only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseFirestore}}/products/{{productId}}?key={{apiKey}}"
          }
        }
      ]
    },
    {
      "name": "03 - Customer & Orders",
      "item": [
        {
          "name": "Get own customer profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseFirestore}}/customers/{{customerUid}}?key={{apiKey}}"
          }
        },
        {
          "name": "Query orders for signed-in user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseFirestore}}:runQuery?key={{apiKey}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [\n      {\n        \"collectionId\": \"orders\"\n      }\n    ],\n    \"where\": {\n      \"fieldFilter\": {\n        \"field\": {\n          \"fieldPath\": \"uid\"\n        },\n        \"op\": \"EQUAL\",\n        \"value\": {\n          \"stringValue\": \"{{customerUid}}\"\n        }\n      }\n    }\n  }\n}"
            }
          }
        }
      ]
    }
  ]
}